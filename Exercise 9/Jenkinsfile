pipeline {
    agent any

    environment {
        VENV_DIR = "${WORKSPACE}/.venv"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
        APP_PID_FILE = "${WORKSPACE}/python-app-deploy/app.pid"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating a virtual environment and installing dependencies...'
                sh '''
                python3 -m venv "$VENV_DIR"
                "$VENV_DIR/bin/pip" install --upgrade pip
                "$VENV_DIR/bin/pip" install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '"$VENV_DIR/bin/python" -m unittest discover -s . -p "test_*.py" -v'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Copying the application to the mock deployment directory...'
                sh '''
                rm -rf "$DEPLOY_DIR"
                mkdir -p "$DEPLOY_DIR"
                cp app.py requirements.txt "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the deployed application...'
                sh '''
                nohup "$VENV_DIR/bin/python" "$DEPLOY_DIR/app.py" > "$DEPLOY_DIR/app.log" 2>&1 &
                echo $! > "$APP_PID_FILE"
                sleep 2
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the running application...'
                sh '''
                "$VENV_DIR/bin/python" -c "import urllib.request; response = urllib.request.urlopen('http://127.0.0.1:5000/', timeout=10); body = response.read().decode(); assert response.status == 200; assert body == 'Hello, Jenkins Multi-Stage Pipeline!'; print(body)"
                '''
            }
        }

        stage('Code Quality') {
            steps {
                echo 'Running Flake8 checks...'
                sh '"$VENV_DIR/bin/flake8" app.py test_app.py'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building the Docker image...'
                sh 'docker build -t jenkins-flask-app .'
            }
        }

        stage('Docker Deploy') {
            steps {
                echo 'Deploying the Flask app in Docker...'
                sh '''
                docker rm -f jenkins-flask-app 2>/dev/null || true
                docker run -d --name jenkins-flask-app -p 5001:5000 jenkins-flask-app
                sleep 2
                "$VENV_DIR/bin/python" -c "import urllib.request; response = urllib.request.urlopen('http://127.0.0.1:5001/', timeout=10); assert response.status == 200; print(response.read().decode())"
                '''
            }
        }
    }

    post {
        always {
            sh '''
            if [ -f "$APP_PID_FILE" ]; then
                kill "$(cat "$APP_PID_FILE")" 2>/dev/null || true
            fi
            docker rm -f jenkins-flask-app 2>/dev/null || true
            '''
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs for details.'
        }
    }
}
